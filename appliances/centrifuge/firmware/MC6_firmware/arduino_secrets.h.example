// Copy to arduino_secrets.h next to this sketch and fill in; it's gitignored. Without it the sketch is USB serial only.
#define SECRET_SSID "lab-wifi"
#define SECRET_PASS "wifi-password"
#define RAV_HOST "192.168.1.20"       // the System 1 laptop's LAN address; rav-server runs with --host 0.0.0.0
#define RAV_PORT 8780
#define DEVICE_NAME "mc6"             // rav-server's --readout-device
#define DEVICE_KEY "board-key"        // rav-server's RAV_DEVICE_KEY, not RAV_TOKEN
