# secrets: API keys live in .env at the repo root (see .env.example); never commit them
.env
.env.*
!.env.example

# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
MUJOCO_LOG.TXT
.claude/
.DS_Store
node_modules/
dist/

# run outputs anywhere: system-1/sim/runs, and runs/ from the harness
runs/
runs_*/
local_out/
onshape_out/

# the sim regenerates these scene and texture files on every run
system-1/sim/assets/so101/_*

# full-quality films are 80+ MB each; the repo keeps the phone-size copies
docs/pitch/films/*.mp4
!docs/pitch/films/*_small.mp4
docs/pitch/films/*.log

# LeRobot is its own git checkout, when you want its main branch
system-1/arm/bringup/lerobot/

# generated by python -m rav_contracts.export_schema
system-2/contracts/schema/

# wrist camera bench outputs; git keeps only the calibration
system-1/arm/camera/camera_out/*
!system-1/arm/camera/camera_out/calib.json
!system-1/arm/camera/camera_out/hand_eye.json
# files the Onshape spike exports on each run; its recorded calls (tests/fixtures/onshape/spike) are kept
system-2/tests/fixtures/onshape/spike_outputs/
# CAD build output (STLs, renders, assembly.glb); rebuild with python -m rav_cad.parametric
system-2/cad/out/
system-2/subjects/appliance/cad/out/
