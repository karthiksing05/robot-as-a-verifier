# Copy to .env at the repo root and fill in. .env is git-ignored; never commit real keys.

# Onshape API keys, from the Onshape Developer Portal (dev-portal.onshape.com > API keys)
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# Only for an enterprise domain; leave empty for cad.onshape.com
ONSHAPE_BASE_URL=

# The development COPY of the appliance document (never the team's real file), e.g.
# https://cad.onshape.com/documents/<did>/w/<wid>/e/<eid>
ONSHAPE_DEV_DOCUMENT_URL=
